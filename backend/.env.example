MOCK_MODE=false
FOREX_API_KEY=
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
NEWS_API_KEY=
DISPLAY_TIMEZONE=Asia/Kolkata
# Optional PostgreSQL SQLAlchemy URL; install psycopg separately.
DATABASE_URL=
# Public data only. No trade execution endpoints exist.
CRYPTO_REST_URL=https://data-api.binance.vision
CRYPTO_WS_URL=wss://data-stream.binance.vision/ws

# Trading Economics key with economic-calendar access
CALENDAR_API_KEY=
# Optional local API protection: use a long random token. Blank disables login.
API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=2400
# Signal policy: the model is never forced into a trade.
SIGNAL_MIN_DIRECTIONAL_PROBABILITY=0.55
SIGNAL_MIN_MARGIN=0.08
SIGNAL_MIN_EXPECTED_ATR_MULTIPLE=0.15
SIGNAL_MIN_RR=2.0
SIGNAL_COST_BPS=8.0
